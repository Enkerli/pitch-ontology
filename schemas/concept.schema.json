{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pitch Ontology Concept",
  "type": "object",
  "required": [
    "id",
    "labels",
    "senses"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "language"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "orientation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "orientation": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cautions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relation",
                "target"
              ],
              "properties": {
                "relation": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "scope": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            }
          },
          "epistemic_status": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}